{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["astro/client", "node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@src/*": ["src/*"],
      "@heroes/*": ["src/heroes/*"],
      "@stores/*": ["src/stores/*"],
      "@levels/*": ["src/levels/*"],
      "@particles/*": ["src/particles/*"],
    }
  },
  "include": ["src", "tests/unit"]
}
