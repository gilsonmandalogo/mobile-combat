---
import '@src/styles.css'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mobile Combat</title>
  </head>
  <body>
    <div id="overlay">
      <section id="main-menu" class="panel menu-panel" data-testid="main-menu">
        <p class="eyebrow">Temple arena</p>
        <h1>Mobile Combat</h1>
        <p class="tagline">Two fighters. One stone floor. First to two rounds.</p>
        <label>
          Mode
          <select id="mode" data-testid="mode-select">
            <option value="local">Versus human</option>
            <option value="ai">Versus AI</option>
          </select>
        </label>
        <label id="difficulty-row">
          Difficulty
          <select id="difficulty" data-testid="difficulty-select">
            <option value="easy">Easy</option>
            <option value="normal" selected>Normal</option>
            <option value="hard">Hard</option>
          </select>
        </label>
        <div class="player-grid">
          <fieldset>
            <legend>Player 1</legend>
            <input id="name1" data-testid="name-player1-input" maxlength="18" value="Player 1" />
            <select id="device1" data-testid="device-player1">
              <option value="keyboard">Keyboard</option>
              <option value="pad-0">Gamepad 1</option>
              <option value="pad-1">Gamepad 2</option>
            </select>
          </fieldset>
          <fieldset>
            <legend>Player 2</legend>
            <input id="name2" data-testid="name-player2-input" maxlength="18" value="Player 2" />
            <select id="device2" data-testid="device-player2">
              <option value="keyboard">Keyboard</option>
              <option value="pad-0">Gamepad 1</option>
              <option value="pad-1">Gamepad 2</option>
            </select>
          </fieldset>
        </div>
        <p id="pad-note" class="note" data-testid="pad-note"></p>
        <div class="menu-actions">
          <button id="start-match" data-testid="start-match" type="button" disabled>Loading arena…</button>
          <button id="open-settings" data-testid="open-settings" type="button">Settings</button>
        </div>
      </section>
      <section id="character-select" class="panel roster-panel" data-testid="character-select" hidden>
        <p class="eyebrow">Roster</p>
        <h2>Choose your fighter</h2>
        <p class="tagline">Player 1 uses A and D. Player 2 uses the arrow keys. A stick or d-pad does the same.</p>
        <div class="roster-grid">
          <div>
            <p data-testid="pick-name-player1" class="pick-name"></p>
            <div id="roster-player1" class="roster" data-testid="roster-player1"></div>
          </div>
          <div>
            <p data-testid="pick-name-player2" class="pick-name"></p>
            <div id="roster-player2" class="roster" data-testid="roster-player2"></div>
          </div>
        </div>
        <div class="menu-actions">
          <button id="confirm-characters" data-testid="confirm-characters" type="button">Arenas</button>
          <button id="characters-back" data-testid="characters-back" type="button">Back</button>
        </div>
      </section>
      <section id="arena-select" class="panel" data-testid="arena-select" hidden>
        <p class="eyebrow">Stage</p>
        <h2>Choose an arena</h2>
        <p class="tagline">A and D, the arrow keys, or a stick cycle the stages.</p>
        <p data-testid="arena-name" class="pick-name"></p>
        <div id="arena-list" class="roster" data-testid="arena-list"></div>
        <div class="menu-actions">
          <button id="confirm-arena" data-testid="confirm-arena" type="button">Fight</button>
          <button id="arenas-back" data-testid="arenas-back" type="button">Back</button>
        </div>
      </section>
      <section id="pause-menu" class="panel" data-testid="pause-menu" hidden>
        <h2>Paused</h2>
        <p class="tagline">The round clock is stopped.</p>
        <div id="move-list" class="move-list" data-testid="move-list"></div>
        <div class="menu-actions">
          <button id="resume" data-testid="resume" type="button">Resume</button>
          <button id="restart" data-testid="restart" type="button">Restart</button>
          <button id="pause-settings" data-testid="pause-settings" type="button">Settings</button>
          <button id="quit" data-testid="quit" type="button">Quit to menu</button>
        </div>
      </section>
      <section id="settings-panel" class="panel settings-panel" data-testid="settings-panel" hidden>
        <h2>Settings</h2>
        <div id="settings-body" class="settings-scroll"></div>
        <div class="menu-actions">
          <button id="reset-bindings" data-testid="reset-bindings" type="button">Reset to defaults</button>
          <button id="close-settings" data-testid="close-settings" type="button">Back</button>
        </div>
      </section>
      <div id="hud" data-testid="hud" hidden>
        <div class="hud-side">
          <div class="hud-meta">
            <span data-testid="hud-name-player1"></span>
            <span data-testid="hud-device-player1" class="device-tag"></span>
          </div>
          <div class="health"><div data-testid="health-player1"></div></div>
          <div class="hud-meta">
            <span data-testid="life-player1" class="life-num"></span>
            <span data-testid="rounds-player1" class="pips"></span>
          </div>
        </div>
        <div>
          <div data-testid="timer" class="timer">60</div>
          <div data-testid="round-label" class="round-label">Round 1</div>
        </div>
        <div class="hud-side right">
          <div class="hud-meta">
            <span data-testid="hud-device-player2" class="device-tag"></span>
            <span data-testid="hud-name-player2"></span>
          </div>
          <div class="health"><div data-testid="health-player2"></div></div>
          <div class="hud-meta">
            <span data-testid="rounds-player2" class="pips"></span>
            <span data-testid="life-player2" class="life-num"></span>
          </div>
        </div>
      </div>
      <div id="banner" data-testid="banner" hidden></div>
    </div>
    <pre id="debug"></pre>
  </body>
</html>

<script>
  import '@src/scene'
</script>
